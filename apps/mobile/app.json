{
  "expo": {
    "name": "Stride",
    "slug": "stride",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.example.stride",
      "runtimeVersion": "exposdk:57.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.amanswamy.stride",
      "versionCode": 2,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C8F31D",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/images/splash-wordmark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to record your route while you track an activity."
        }
      ],
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "We count your steps while you record a run, walk or hike."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "We use the camera to scan a friend's Stride QR code so you can follow them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "We use your contacts so you can invite friends to Stride. They're never uploaded."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e419f43-5433-41ca-be3d-8ac8867a9622"
      }
    },
    "owner": "aman_swamy",
    "updates": {
      "url": "https://u.expo.dev/4e419f43-5433-41ca-be3d-8ac8867a9622"
    }
  }
}
