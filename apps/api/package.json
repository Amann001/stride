{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ops": "tsx --env-file-if-exists=.env src/ops.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@repo/shared": "*",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
