{
  "name": "stride",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "dev:mobile": "npm run start --workspace mobile",
    "db:migrate": "npm run migrate --workspace api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
